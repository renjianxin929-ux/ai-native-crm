{
  "contract_version": "battle-card-applicability-v1",
  "description": "Shared applicability contract consumed by BOTH TypeScript parser (src/lib/battleCard/parser.ts) and Rust authoritative parser (src-tauri/src/battle_card_authoritative.rs). Single source of truth; no independent term tables allowed.",
  "normalization": {
    "mode": "lowercase_unicode",
    "note": "Both statement and terms are normalized via Unicode lowercase (toLowerCase / to_lowercase) before matching. Chinese is unaffected; ASCII (VOC/voc/Voc/CE/UL) is normalized to lowercase."
  },
  "precedence": [
    "FORMULA_CONDITIONAL",
    "GLOBAL",
    "PARTIAL",
    "CONDITIONAL",
    "UNSUPPORTED",
    "COMPOSITE_FALLBACK"
  ],
  "terms": {
    "GLOBAL": [
      "出海",
      "多国家",
      "多平台",
      "官方案例",
      "销售及业务信息",
      "全球",
      "覆盖"
    ],
    "PARTIAL": [
      "认证",
      "电压",
      "插头",
      "国家版本",
      "版本",
      "说明书",
      "包装"
    ],
    "CONDITIONAL": [
      "配方",
      "成分",
      "功效",
      "售后",
      "voc"
    ],
    "UNSUPPORTED": [
      "传闻",
      "未经证实",
      "暂无法核实",
      "待核实"
    ]
  },
  "formula_priority": {
    "rule": "FORMULA_CONDITIONAL",
    "formula_terms": [
      "配方",
      "成分"
    ],
    "product_line_basis_terms": [
      "产品线",
      "具体产品",
      "型号"
    ],
    "note": "statement contains formula term AND no product-line basis term → CONDITIONAL, evaluated before all other groups."
  },
  "composite_fallback": {
    "rule": "COMPOSITE_FALLBACK",
    "composite_terms": [
      "功效",
      "内容",
      "达人",
      "版本",
      "电压",
      "插头",
      "认证",
      "包装",
      "说明书",
      "售后",
      "voc",
      "配方",
      "成分"
    ],
    "composite_threshold": 3,
    "note": "raw material (full text) hits >= 3 composite terms → composite=true; unmatched statement falls back to GLOBAL if composite else CONDITIONAL."
  },
