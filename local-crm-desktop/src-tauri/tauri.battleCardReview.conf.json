{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "local-crm-battle-card-review",
  "identifier": "com.localcrm.desktop.battle-card-review",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "销售 CRM Battle Card Review",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--remote-debugging-port=9224 --remote-allow-origins=*"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
